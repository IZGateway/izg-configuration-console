generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accesscontrol {
  category String   @db.VarChar(16)
  name     String   @db.VarChar(256)
  member   String   @db.VarChar(256)
  allow    Boolean?

  @@id([category, name, member])
}

model audit_history {
  id         Int                      @id @default(autoincrement())
  tableName  String                   @db.VarChar(50)
  userName   String                   @db.VarChar(50)
  changeType audit_history_changeType
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime                 @default(now()) @db.DateTime(0)
}

model destination_type {
  type_id      Int            @id
  type         String?        @db.VarChar(45)
  destinations destinations[]

  @@index([type_id], map: "IDX_destination_type")
}

model destinations {
  dest_id                    String                       @db.VarChar(128)
  dest_type                  Int
  dest_uri                   String                       @db.VarChar(1024)
  username                   String?                      @db.VarChar(50)
  password                   String?                      @db.VarChar(256)
  facility_id                String?                      @db.VarChar(50)
  MSH3                       String?                      @db.VarChar(50)
  MSH4                       String?                      @db.VarChar(50)
  MSH5                       String?                      @db.VarChar(50)
  MSH6                       String?                      @db.VarChar(50)
  MSH22                      String?                      @db.VarChar(50)
  RXA11                      String?                      @db.VarChar(50)
  dest_version               String?                      @db.VarChar(50)
  pass_expiry                DateTime?                    @db.Date
  jurisdiction_id            Int
  destination_change_request destination_change_request[]
  destination_type           destination_type             @relation(fields: [dest_type], references: [type_id], onUpdate: Restrict, map: "destinations_ibfk_1")
  jurisdiction               jurisdiction                 @relation(fields: [jurisdiction_id], references: [jurisdiction_id], map: "destinations_ibfk_2")

  @@id([dest_id, dest_type])
  @@index([dest_type], map: "dest_type")
  @@index([jurisdiction_id], map: "jurisdiction_id")
}

model jurisdiction {
  jurisdiction_id Int            @id @default(autoincrement())
  name            String         @db.VarChar(48)
  description     String         @db.VarChar(128)
  dest_prefix     String?        @db.VarChar(10)
  destinations    destinations[]
}

model messageheaderinfo {
  msh        String  @id @db.VarChar(128)
  dest_id    String? @db.VarChar(128)
  iis        String? @db.VarChar(128)
  sourceType String? @db.VarChar(128)
}

model destination_change_request {
  id           Int           @id @default(autoincrement())
  username     String?       @db.VarChar(50)
  password     String?       @db.VarChar(50)
  facility_id  String?       @db.VarChar(50)
  MSH3         String?       @db.VarChar(50)
  MSH4         String?       @db.VarChar(50)
  MSH5         String?       @db.VarChar(50)
  MSH6         String?       @db.VarChar(50)
  MSH22        String?       @db.VarChar(50)
  RXA11        String?       @db.VarChar(50)
  jira_id      String?       @db.VarChar(50)
  dest_id      String?       @db.VarChar(128)
  dest_type    Int?
  scheduledAt  DateTime      @default(now()) @db.DateTime(0)
  requestedAt  DateTime      @default(now()) @db.DateTime(0)
  requestedBy  String?       @db.VarChar(50)
  destinations destinations? @relation(fields: [dest_id, dest_type], references: [dest_id, dest_type], onDelete: NoAction, onUpdate: NoAction, map: "destination_change_request_ibfk_1")

  @@index([dest_id, dest_type], map: "dest_id")
}

enum audit_history_changeType {
  Insert
  Update
  Delete
}
