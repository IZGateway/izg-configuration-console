{
  "name": "izg-configuration-console",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "start:local-dev": "docker-compose -f docker-compose.local.yml up -d && npm run dev",
    "start:local-docker": "docker-compose -f docker-compose.local.yml -f docker-compose.override.yml up -d",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "code-quality-check": "next lint && npm run type-check",
