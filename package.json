    "@mui/material": "^5.18.0",
    "@mui/x-data-grid": "7.29.12",
    "@mui/x-date-pickers": "^6.20.2",
    "@types/node": "^20.19.37",
    "@types/node-fetch": "^2.6.13",
    "@types/tcp-ping": "^0.1.6",
    "@types/xml2js": "^0.4.14",
    "@xmldom/xmldom": "^0.9.8",
    "axios": "^1.13.6",
