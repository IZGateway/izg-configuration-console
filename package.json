    "dotenv": "^16.4.7",
    "eslint-config-next": "14.0.1",
    "eslint-config-prettier": "^8.8.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.8",
    "react-axe": "^3.5.4",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@types/react": "19.0.10",
    "prismjs": "1.30.0",
