              }
            }
          },
          "401": {
            "description": "Unauthorized - user not authenticated"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": [
          "IZ Gateway"
        ]
      }
    }
  },
  "components": {},
  "tags": []
}
