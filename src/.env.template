NEXTAUTH_URL=<auth url> # base url of the application
NEXTAUTH_SECRET=<some secret>
OKTA_CLIENT_ID=<client id provided by Okta>
OKTA_ISSUER=<Okta url>
OKTA_CLIENT_SECRET=<client secret generated by Okta>
SHOW_SQL_IN_CONSOLE=<true | false >
DATABASE_URL=<database connection URL>

JWT_SIGNING_SECRET_ID=<AWS Secrets Manager secret ID for API key JWT signing>
# Dev/test ONLY: skip the real DNS TXT lookup during API-key domain verification.
# Ignored (bypass forced off) whenever NODE_ENV=production. Leave unset/false normally.
ALLOW_DNS_VERIFY_BYPASS=<true | false — default false>
# Dev/test ONLY: serve a hardcoded Organizations list (jurisdictions + senders)
# in the API Key Management UI instead of calling /api/jurisdictions, so the
# create/renew/validate workflow can be tested without touching DynamoDB.
# Leave unset/false normally. See src/components/ApiKeyManagement/mockData.ts.
NEXT_PUBLIC_MOCK_ORGANIZATIONS=<true | false — default false>
IZG_MAX_STATUS_HISTORY_RETURNED=<default is 4>
IZG_ENDPOINT_CRT_PATH=certs//<your cert>
IZG_ENDPOINT_KEY_PATH=certs//<your key>
IZG_ENDPOINT_PASSCODE=<your pass>
NEXTAUTH_DEBUG=<true | false>
IZG_STATUS_ENDPOINT_URL=<IZG Hub status endpoint>
AUTOMATED_TEST_RUN_DURATION=900000
JIRA_API_URL=<jira endpoint URL>
JIRA_API_AUTH_BASE64=<string for Jira auth>
JIRA_API_PROJECT_ID=<id of jira project to create ticket>
JIRA_API_ISSUE_TYPE=<type of issue created in Jira>
JIRA_API_ISSUE_DEPLOY_STATE=<issue state when deployment is allowed>